{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mockagents.dev/schema/v1/mcpserver.json",
  "title": "MockAgents MCPServer Definition",
  "description": "Declarative configuration for a mock Model Context Protocol server.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string", "const": "mockagents/v1" },
    "kind": { "type": "string", "const": "MCPServer" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 63 },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "tenant_id": { "type": "string", "description": "Owning tenant. Written by the server when a definition is saved through the multi-tenant API; never trusted from a request body. Omit it in hand-written files (empty means global)." }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": { "type": "string", "description": "MCP protocol version returned by initialize." },
        "strictArgs": { "type": "boolean", "description": "Validate tools/call arguments against each tool's inputSchema (default true). Violations return an isError:true execution result. Set false to accept any arguments.", "default": true },
        "faults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seed": { "type": "integer" },
            "rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "latency_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
            "timeout_ms": { "type": "integer", "minimum": 0, "maximum": 60000, "description": "Sleep this long, then answer with a timeout error." },
            "status_code": { "type": "integer", "minimum": 400, "maximum": 599, "description": "HTTP status for an injected transport error (HTTP transport only)." },
            "disconnect": { "type": "boolean", "description": "Close the connection without a response." },
            "reset": { "type": "boolean", "description": "Reset the connection (TCP RST where possible)." },
            "malformed": { "type": "boolean", "description": "Answer with a body that is not valid JSON." },
            "malformed_schema": { "type": "boolean", "description": "Answer with valid JSON that violates the JSON-RPC response schema." },
            "truncate_after_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576, "description": "Cut the response after this many bytes." },
            "error": { "type": "boolean" },
            "operation_rates": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
            "fixture_rates": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
            "sequence_rates": { "type": "object", "propertyNames": { "pattern": "^[1-9][0-9]*$" }, "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }, "description": "Per-request-number rates, keyed by the 1-based request sequence." }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tools":     { "type": "boolean" },
            "resources": { "type": "boolean" },
            "prompts":   { "type": "boolean" },
            "logging":   { "type": "boolean" }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name":        { "type": "string" },
              "description": { "type": "string" },
              "inputSchema": { "type": "object" },
              "responses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "match":   { "type": "object" },
                    "default": { "type": "boolean" },
                    "isError": { "type": "boolean" },
                    "content": {
                      "type": "array",
                      "items": { "$ref": "#/$defs/ContentBlock" }
                    }
                  }
                }
              }
            }
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["uri"],
            "additionalProperties": false,
            "properties": {
              "uri":         { "type": "string" },
              "name":        { "type": "string" },
              "description": { "type": "string" },
              "mimeType":    { "type": "string" },
              "text":        { "type": "string" },
              "blob":        { "type": "string", "description": "Base64-encoded binary content." }
            }
          }
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name":        { "type": "string" },
              "description": { "type": "string" },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "additionalProperties": false,
                  "properties": {
                    "name":        { "type": "string" },
                    "description": { "type": "string" },
                    "required":    { "type": "boolean" }
                  }
                }
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["role", "content"],
                  "additionalProperties": false,
                  "properties": {
                    "role":    { "type": "string", "enum": ["user", "assistant"] },
                    "content": { "$ref": "#/$defs/ContentBlock" }
                  }
                }
              }
            }
          }
        },
        "completions": {
          "type": "array",
          "description": "Autocomplete catalog answered by completion/complete. Each entry binds a (refType, refName, argName) triple to a static value list; empty refType/refName wildcard.",
          "items": {
            "type": "object",
            "required": ["argName", "values"],
            "additionalProperties": false,
            "properties": {
              "refType": { "type": "string", "enum": ["ref/prompt", "ref/resource"] },
              "refName": { "type": "string" },
              "argName": { "type": "string" },
              "values":  { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ContentBlock": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type":     { "type": "string", "enum": ["text", "image", "audio", "resource"] },
        "text":     { "type": "string" },
        "data":     { "type": "string", "description": "Base64-encoded data for image/audio content." },
        "mimeType": { "type": "string" },
        "uri":      { "type": "string" },
        "blob":     { "type": "string", "description": "Base64-encoded contents for an embedded resource block (text XOR blob)." }
      }
    }
  }
}
