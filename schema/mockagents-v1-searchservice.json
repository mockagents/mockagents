          "type": "object"
        },
        "partial_results": {
          "anyOf": [
            {
              "$ref": "#/$defs/types.SearchPartialResultsFault"
            },
            {
              "type": "null"
            }
          ]
        },
        "rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "type": "integer"
        },
        "status_code": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "maximum": 599,
              "minimum": 400,
              "type": "integer"
            }
          ]
        }
      },
      "type": "object",
      "x-go-type": "github.com/mockagents/mockagents/internal/types.SearchFaults"
    },
    "types.SearchMatch": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "default": {
              "const": false
            },
            "query_contains": {
              "minLength": 1
            },
            "query_regex": {
              "const": ""
            }
          },
          "required": [
            "query_contains"
          ]
        },
        {
          "properties": {
            "default": {
              "const": false
            },
            "query_contains": {
              "const": ""
            },
            "query_regex": {
              "minLength": 1
            }
          },
          "required": [
            "query_regex"
          ]
        },
        {
          "properties": {
            "default": {
              "const": true
            },
            "query_contains": {
              "const": ""
            },
            "query_regex": {
              "const": ""
            }
          },
          "required": [
            "default"
          ]
        }
      ],
      "properties": {
        "default": {
          "type": "boolean"
        },
        "query_contains": {
          "type": "string"
        },
        "query_regex": {
          "type": "string"
        }
      },
      "type": "object",
      "x-go-type": "github.com/mockagents/mockagents/internal/types.SearchMatch"
    },
    "types.SearchPartialResultsFault": {
      "additionalProperties": false,
      "properties": {
        "max_results": {
          "maximum": 20,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object",
      "x-go-type": "github.com/mockagents/mockagents/internal/types.SearchPartialResultsFault"
    },
    "types.SearchResponse": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/types.SearchResult"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object",
      "x-go-type": "github.com/mockagents/mockagents/internal/types.SearchResponse"
    },
    "types.SearchResult": {
