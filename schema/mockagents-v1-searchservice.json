          "maxContains": 1,
          "minContains": 0,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "provider"
      ],
      "type": "object",
      "x-go-type": "github.com/mockagents/mockagents/internal/types.SearchServiceSpec"
