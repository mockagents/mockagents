      "required": [
        "title",
        "url"
      ],
      "type": "object",
      "x-go-type": "github.com/mockagents/mockagents/internal/types.SearchResult"
    },
    "types.SearchScenario": {
      "additionalProperties": false,
      "properties": {
        "match": {
