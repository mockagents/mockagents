{
  "$defs": {
    "types.Metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tenant_id": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "x-go-type": "github.com/mockagents/mockagents/internal/types.Metadata"
    },
    "types.SearchFaults": {
      "additionalProperties": false,
      "properties": {
        "disconnect": {
          "type": "boolean"
        },
        "latency_ms": {
          "maximum": 60000,
          "minimum": 0,
          "type": "integer"
        },
        "malformed_json": {
          "type": "boolean"
        },
        "operation_rates": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
