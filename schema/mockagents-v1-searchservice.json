        },
        "kind": {
          "const": "SearchService"
        },
        "metadata": {
          "$ref": "#/$defs/types.Metadata"
        },
        "spec": {
          "$ref": "#/$defs/types.SearchServiceSpec"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "type": "object",
      "x-go-type": "github.com/mockagents/mockagents/internal/types.SearchServiceDefinition"
    },
    "types.SearchServiceSpec": {
      "additionalProperties": false,
      "else": {
        "properties": {
          "scenarios": {
            "maxItems": 0
          }
        }
      },
      "if": {
        "properties": {
          "provider": {
            "pattern": "^[tT][aA][vV][iI][lL][yY]$"
          }
        }
      },
      "properties": {
        "faults": {
          "$ref": "#/$defs/types.SearchFaults"
        },
        "provider": {
          "pattern": "^(?:[tT][aA][vV][iI][lL][yY]|[cC][oO][hH][eE][rR][eE]-[rR][eE][rR][aA][nN][kK]|[oO][pP][eE][nN][aA][iI]-[mM][oO][dD][eE][rR][aA][tT][iI][oO][nN][sS])$",
          "type": "string"
        },
        "scenarios": {
          "contains": {
            "properties": {
              "match": {
                "properties": {
                  "default": {
                    "const": true
                  }
                },
                "required": [
