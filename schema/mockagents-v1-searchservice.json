        },
        "name": {
          "pattern": "\\S",
          "type": "string"
        },
        "response": {
          "$ref": "#/$defs/types.SearchResponse"
        }
      },
      "required": [
        "name",
        "match"
      ],
      "type": "object",
      "x-go-type": "github.com/mockagents/mockagents/internal/types.SearchScenario"
