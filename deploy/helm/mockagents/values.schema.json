{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "multiReplica": {
      "type": "object",
      "required": ["acknowledged"],
      "properties": { "acknowledged": { "type": "boolean" } }
    },
    "env": { "type": "object" },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "required": ["enabled", "authorization"],
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "interval": { "type": "string", "minLength": 1 },
        "scrapeTimeout": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "authorization": {
          "type": "object",
          "required": ["enabled", "type", "credentials"],
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "type": "string", "enum": ["Bearer"] },
            "credentials": {
              "type": "object",
              "required": ["name", "key"],
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
