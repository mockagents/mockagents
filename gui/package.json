{
  "name": "mockagents-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Web GUI for browsing MockAgents — agent catalog, agent detail, and interaction logs.",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
